# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so it must
# never carry a real value.
#
# This app is a static SPA with no server, so every variable below is compiled
# into the bundle and is readable by anyone who loads the page. Only put things
# here that are safe to publish. A Supabase service-role key, a database
# password, or any API key that bypasses row-level security must never go in
# this file or in `.env` — see the note at the top of `src/lib/config.ts`.

# Which storage backend `src/lib/data/index.ts` constructs: `local` or `supabase`.
# Defaults to `local`. `supabase` is not implemented yet (roadmap item 4) and
# will throw on boot until `SyncRepo` lands.
PUBLIC_DATA_BACKEND=local

# Required only when PUBLIC_DATA_BACKEND=supabase.
# The anon key is publishable by design — row-level security on `user_id` is
# what protects the data, not the secrecy of this key.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
